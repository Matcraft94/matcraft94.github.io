---
import type { CollectionEntry } from 'astro:content';

interface Props {
  study: CollectionEntry<'caseStudies'>;
}

const { study } = Astro.props;
const projectStatusLabels = {
  'production': 'In production',
  'open-source': 'Open source',
  'research-in-progress': 'Research in progress',
  'experiment': 'Experiment',
};
---

<a
  href={`/case-studies/${study.id}/`}
  class="group flex h-full flex-col rounded-lg border border-ink-3 bg-ink-2 p-6 transition-colors hover:border-accent/70 focus-visible:outline-none"
  aria-label={`Read case study: ${study.data.title}`}
>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs">
    <span class="text-accent-2">{study.data.category.replaceAll('-', ' ')}</span>
    <span aria-hidden="true" class="text-ink-3">/</span>
    <span class="text-muted">{projectStatusLabels[study.data.projectStatus]}</span>
  </div>
  <h3 class="mt-4 text-xl font-semibold leading-snug group-hover:text-accent transition-colors">
    {study.data.title}
  </h3>
  <p class="mt-3 text-sm leading-6 text-muted">{study.data.subtitle ?? study.data.description}</p>
  {study.data.metrics && (
    <div class="mt-6 grid grid-cols-2 gap-x-4 gap-y-5 border-t border-ink-3 pt-5">
      {study.data.metrics.slice(0, 3).map((metric) => (
        <div>
          <div class="font-mono text-lg text-accent">{metric.value}</div>
          <div class="mt-1 text-xs leading-5 text-muted">{metric.label}</div>
          {metric.note && <div class="mt-1 text-[11px] leading-4 text-muted/70">{metric.note}</div>}
        </div>
      ))}
    </div>
  )}
  <span class="mt-auto pt-6 text-sm text-accent">Read case study →</span>
</a>
