---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const studies = (await getCollection('caseStudies'))
  .filter((s) => s.data.status === 'published')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = studies.filter((s) => s.data.featured);
const publications = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year);
---

<Base title="Home">
  <section class="max-w-5xl mx-auto px-6 pt-20 pb-16">
    <p class="font-mono text-xs text-accent tracking-widest uppercase mb-4">Mathematical Engineer · Data Scientist</p>
    <h1 class="text-4xl sm:text-5xl font-bold leading-tight max-w-3xl">
      Statistical rigor, production code,<br />auditable AI.
    </h1>
    <p class="mt-6 text-muted text-lg max-w-2xl leading-relaxed">
      I work at the two gaps that are usually open: between statistical rigor and production code,
      and between experimental AI and auditable AI. I build quantitative systems — from Hawkes-process
      order flow models to psychometric pipelines serving institutional decisions — where nothing ships
      without formal evidence and passing tests.
    </p>
    <div class="mt-8 flex gap-4">
      <a href="/case-studies/" class="px-5 py-2.5 bg-accent text-ink font-medium text-sm rounded hover:opacity-90 transition-opacity">
        View case studies
      </a>
      <a href="mailto:mat.eduardo.arias@outlook.com" class="px-5 py-2.5 border border-ink-3 text-sm rounded hover:border-accent hover:text-accent transition-colors">
        Get in touch
      </a>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-12 border-t border-ink-3">
    <h2 class="font-mono text-xs text-muted tracking-widest uppercase mb-8">Featured work</h2>
    <div class="grid gap-6 md:grid-cols-2">
      {featured.map((s) => (
        <a href={`/case-studies/${s.id}/`} class="block p-6 bg-ink-2 border border-ink-3 rounded-lg hover:border-accent transition-colors group">
          <div class="font-mono text-xs text-accent-2 mb-2">{s.data.category}</div>
          <h3 class="text-xl font-semibold group-hover:text-accent transition-colors">{s.data.title}</h3>
          <p class="mt-2 text-muted text-sm leading-relaxed">{s.data.description}</p>
          {s.data.metrics && (
            <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
              {s.data.metrics.slice(0, 3).map((m) => (
                <div>
                  <div class="font-mono text-lg text-accent">{m.value}</div>
                  <div class="text-xs text-muted">{m.label}</div>
                </div>
              ))}
            </div>
          )}
        </a>
      ))}
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-12 border-t border-ink-3">
    <div class="flex items-center justify-between mb-8">
      <h2 class="font-mono text-xs text-muted tracking-widest uppercase">All case studies</h2>
      <a href="/case-studies/" class="text-sm text-accent hover:underline">Browse all →</a>
    </div>
    <div class="divide-y divide-ink-3">
      {studies.map((s) => (
        <a href={`/case-studies/${s.id}/`} class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 py-4 group">
          <span class="font-medium group-hover:text-accent transition-colors">{s.data.title}</span>
          <span class="text-sm text-muted font-mono">{s.data.category} · {s.data.pubDate.getFullYear()}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-12 border-t border-ink-3">
    <h2 class="font-mono text-xs text-muted tracking-widest uppercase mb-8">Publications</h2>
    {publications.map((p) => (
      <div class="py-4 border-b border-ink-3 last:border-0">
        <div class="text-sm text-muted font-mono mb-1">{p.data.authors} — {p.data.venue}, {p.data.year}</div>
        <div class="text-lg font-medium">{p.data.title}</div>
      </div>
    ))}
  </section>
</Base>
