---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const studies = await getCollection('caseStudies');
  return studies
    .filter((s) => s.data.status === 'published')
    .map((s) => ({ params: { slug: s.id }, props: { study: s } }));
}

const { study } = Astro.props;
const { Content } = await render(study);
const projectStatusLabels = {
  'production': 'In production',
  'open-source': 'Open source',
  'research-in-progress': 'Research in progress',
  'experiment': 'Experiment',
};
const codeAvailabilityLabels = {
  'public': 'Public source',
  'partial': 'Partial source availability',
  'private': 'Private code · sanitized case',
};
---

<Base title={study.data.title} description={study.data.description}>
  <article class="max-w-3xl mx-auto px-6 pt-16 pb-8">
    <a href="/case-studies/" class="text-sm text-muted hover:text-accent transition-colors">← All work</a>
    <div class="mt-8 flex flex-wrap gap-2 text-xs">
      <span class="rounded-full border border-ink-3 px-3 py-1 text-accent-2">{projectStatusLabels[study.data.projectStatus]}</span>
      <span class="rounded-full border border-ink-3 px-3 py-1 text-muted">{codeAvailabilityLabels[study.data.codeAvailability]}</span>
    </div>
    <h1 class="mt-5 text-3xl sm:text-4xl font-bold leading-tight">{study.data.title}</h1>
    {study.data.subtitle && <p class="mt-4 text-lg text-muted leading-relaxed">{study.data.subtitle}</p>}
    <p class="mt-5 leading-7 text-paper/85">{study.data.description}</p>
    <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted">
      <span class="font-mono">{study.data.pubDate.toISOString().slice(0, 10)}</span>
      <span>{study.data.category.replaceAll('-', ' ')}</span>
      {study.data.repo && (
        <a href={study.data.repo} class="text-accent hover:underline">View source ↗</a>
      )}
    </div>
    {study.data.metrics && (
      <div class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-px bg-ink-3 border border-ink-3 rounded-lg overflow-hidden">
        {study.data.metrics.map((m) => (
          <div class="p-5 bg-ink-2">
            <div class="font-mono text-2xl text-accent">{m.value}</div>
            <div class="text-xs text-muted mt-1.5">{m.label}</div>
            {m.note && <div class="text-xs text-muted/70 mt-0.5">{m.note}</div>}
          </div>
        ))}
      </div>
    )}
    {study.data.stack && (
      <div class="mt-6 flex flex-wrap gap-2">
        {study.data.stack.map((t) => (
          <span class="text-xs font-mono px-2.5 py-1 bg-ink-3 rounded text-muted">{t}</span>
        ))}
      </div>
    )}
    <div class="mt-14 prose-invert">
      <Content />
    </div>
  </article>
</Base>
