---
import Base from '../layouts/Base.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import { getCollection, getEntry } from 'astro:content';

const optimization = await getEntry('caseStudies', 'ml-graph-partitioning');
const scientificStudies = await getCollection('caseStudies', (study) =>
  ['neural-pdes', 'tda-psych'].includes(study.id) && study.data.status === 'published'
);
const publications = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year);
---

<Base title="Research" description="Mathematical research in combinatorial optimization, scientific machine learning, psychometrics, and nonlinear PDEs.">
  <section class="max-w-5xl mx-auto px-6 pt-16 pb-10">
    <p class="text-sm font-medium text-accent">RESEARCH</p>
    <h1 class="mt-3 text-3xl sm:text-4xl font-bold">Mathematical questions, computational evidence</h1>
    <p class="mt-4 max-w-2xl leading-7 text-muted">
      I study how learned models can contribute to mathematical and statistical
      systems without hiding assumptions or weakening correctness checks.
    </p>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-10 border-t border-ink-3">
    <div class="grid gap-8 lg:grid-cols-[1fr_1.4fr] lg:items-start">
      <div>
        <p class="text-xs font-medium text-accent-2">CURRENT RESEARCH</p>
        <h2 class="mt-3 text-2xl font-semibold">ML-assisted combinatorial optimization</h2>
        <p class="mt-4 text-sm text-muted">Research in progress</p>
      </div>
      <div>
        <p class="leading-7 text-muted">
          Column generation chooses which new decision variables enter an
          optimization model. This research tests learned column ranking and
          dual stabilization while an exact solver continues to verify every
          graph partition. LP progress, integer quality, and runtime are
          evaluated separately so one cannot be used to imply another.
        </p>
        <a href={`/case-studies/${optimization.id}/`} class="inline-block mt-5 text-sm text-accent hover:underline">
          Read the research case →
        </a>
      </div>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-12 border-t border-ink-3">
    <p class="text-xs font-medium text-accent-2">SCIENTIFIC & STATISTICAL COMPUTING</p>
    <h2 class="mt-3 mb-7 text-2xl font-semibold">Related research software</h2>
    <div class="grid gap-5 md:grid-cols-2">
      {scientificStudies.map((study) => <CaseStudyCard study={study} />)}
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-12 border-t border-ink-3">
    <div class="flex items-end justify-between gap-4 mb-5">
      <div>
        <p class="text-xs font-medium text-accent-2">PUBLICATIONS</p>
        <h2 class="mt-3 text-2xl font-semibold">Peer-reviewed work</h2>
      </div>
      <a href="/publications/" class="text-sm text-accent hover:underline">All publications →</a>
    </div>
    {publications.map((publication) => (
      <a href={`/publications/${publication.id}/`} class="group block border-t border-ink-3 py-6">
        <h3 class="text-xl font-medium group-hover:text-accent transition-colors">{publication.data.title}</h3>
        <p class="mt-2 text-sm text-muted">{publication.data.authors}</p>
        <p class="mt-1 text-sm text-muted">{publication.data.venue}, {publication.data.year}</p>
      </a>
    ))}
  </section>
</Base>
